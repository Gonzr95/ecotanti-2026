{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "backoffice",
  "projectType": "application",
  "generators": {},
  "sourceRoot": "projects/backoffice/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "projects/backoffice/src/main.ts",
        "tsConfig": "projects/backoffice/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "projects/backoffice/public"
          }
        ],
        "styles": [
          "projects/backoffice/src/styles.css"
        ],
        "outputPath": "dist/backoffice"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "projects/backoffice/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "backoffice:build:production"
        },
        "development": {
          "buildTarget": "backoffice:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@angular/build:unit-test"
    }
  }
}